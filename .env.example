# Reference env template for the monorepo.
# Copy values into:
# - apps/web/.env.local
# - apps/api/.env

# apps/web/.env.local
VITE_API_BASE_URL=http://localhost:4000

# apps/api/.env
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
# Local Docker/Postgres default. For Neon in production, use the pooled connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/izledger
# Optional for deploy-time migrations when DATABASE_URL uses a Neon pooler:
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxxxx.REGION.aws.neon.tech/DB_NAME?sslmode=require
DIRECT_URL=
SESSION_COOKIE_NAME=izledger_session
SESSION_TTL_DAYS=14
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=1
STORAGE_ENABLED=false
LOG_LEVEL=info
