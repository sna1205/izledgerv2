# Reference env template for the monorepo.
# Copy values into:
# - apps/web/.env.local
# - apps/api/.env

# apps/web/.env.local
API_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000

# apps/api/.env
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
# Local Docker/Postgres default. For Neon in production, use the pooled connection string:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/izledger
# Optional for deploy-time migrations when DATABASE_URL uses a Neon pooler:
# DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxxxx.REGION.aws.neon.tech/DB_NAME?sslmode=require
DIRECT_URL=
# Dedicated local integration database used by `npm test --workspace @izledger/api`.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/izledger_test
# Release/CI only: disposable PostgreSQL database used for `prisma migrate diff`.
PRISMA_MIGRATE_CHECK_SHADOW_DATABASE_URL=
SESSION_COOKIE_NAME=izledger_session
SESSION_TTL_DAYS=14
SESSION_COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=1
STORAGE_ENABLED=false
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_READS=true
STORAGE_SIGNED_READ_TTL_SECONDS=900
# Restore drill only: optional restored API origin checked by `npm run restore:verify`.
RESTORE_VERIFY_API_URL=
# Restore drill only: positive integer or `all`.
RESTORE_VERIFY_STORAGE_SAMPLE_SIZE=25
RESTORE_VERIFY_REQUIRE_API=false
RESTORE_VERIFY_REQUIRE_STORAGE=false
LOG_LEVEL=info
