# Monorepo env reference.
# Local app defaults live in:
# - apps/web/.env
# - apps/api/.env
#
# Override only on your own machine with:
# - apps/web/.env.local
# - apps/api/.env.local
#
# Production values belong in deployment platform env settings or
# `apps/web/.env.production` and `apps/api/.env.production`.

# apps/web/.env
VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:4000
VITE_FEATURE_ECONOMIC_CALENDAR=development

# apps/api/.env
NODE_ENV=development
APP_ENV=development
APP_DEBUG=false
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/izledger
DIRECT_URL=
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/izledger_test
PRISMA_MIGRATE_CHECK_SHADOW_DATABASE_URL=
SESSION_COOKIE_NAME=izledger_session
SESSION_TTL_DAYS=14
SESSION_COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=1
STORAGE_ENABLED=false
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_READS=true
STORAGE_SIGNED_READ_TTL_SECONDS=900
# Use `trading-economics` in production for real historical and future calendar ranges.
ECONOMIC_CALENDAR_PROVIDER=fair-economy
ECONOMIC_CALENDAR_PROVIDER_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
ECONOMIC_CALENDAR_TRADING_ECONOMICS_BASE_URL=https://api.tradingeconomics.com
ECONOMIC_CALENDAR_TRADING_ECONOMICS_API_KEY=
ECONOMIC_CALENDAR_PROVIDER_TIMEOUT_MS=7000
ECONOMIC_CALENDAR_CACHE_TTL_SECONDS=300
RESTORE_VERIFY_API_URL=
RESTORE_VERIFY_STORAGE_SAMPLE_SIZE=25
RESTORE_VERIFY_REQUIRE_API=false
RESTORE_VERIFY_REQUIRE_STORAGE=false
LOG_LEVEL=info
