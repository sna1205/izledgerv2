generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  Personal
  Funded
  Challenge
  Demo
  Crypto
}

enum TradeDirection {
  Buy
  Sell
}

enum TradeResult {
  Win
  Loss
  Breakeven
}

enum TradeSession {
  Asia
  London
  New_York
}

enum TradeEmotion {
  Calm
  Focused
  Confident
  Anxious
  Frustrated
}

enum ReviewType {
  daily
  weekly
  trade
}

enum ReviewRuleStatus {
  Yes
  Partially
  No
}

enum ReviewRiskStatus {
  Yes
  Partially
  No
}

enum ReviewEmotion {
  Calm
  Confident
  Hesitant
  FOMO
  Revenge
  Frustrated
}

enum ChecklistEnforcementMode {
  soft
  strict
}

enum ScreenshotCleanupAction {
  deleteObject
  deleteExpiredUploadRecord
  deleteDanglingScreenshotRecord
}

enum ScreenshotCleanupReason {
  screenshotDelete
  expiredUpload
  orphanObject
  danglingReference
}

model User {
  id                       String                   @id @default(uuid()) @db.Uuid
  username                 String                   @unique @db.Citext
  passwordHash             String                   @map("password_hash")
  checklistEnforcementMode ChecklistEnforcementMode @default(soft) @map("checklist_enforcement_mode")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  accounts                 Account[]
  setups                   Setup[]
  trades                   Trade[]
  checklistRules           ChecklistRule[]
  screenshots              TradeScreenshot[]
  screenshotUploads        TradeScreenshotUpload[]
  tradeShares              TradeShare[]
  reviews                  Review[]
  sessions                 Session[]

  @@map("users")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  lastAccessedAt DateTime  @default(now()) @map("last_accessed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  name      String
  broker    String
  type      AccountType
  balance   Decimal     @db.Decimal(18, 2)
  currency  String
  isDefault Boolean     @default(false) @map("is_default")
  isArchived Boolean    @default(false) @map("is_archived")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades    Trade[]
  checklistRules ChecklistRule[]

  @@index([userId])
  @@map("accounts")
}

model Setup {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  nameNormalized String @map("name_normalized")
  description String
  entryLogic String?   @map("entry_logic")
  confirmationLogic String? @map("confirmation_logic")
  invalidationLogic String? @map("invalidation_logic")
  notes      String?
  color      String
  isArchived Boolean   @default(false) @map("is_archived")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades     Trade[]
  checklistRules ChecklistRule[]

  @@unique([userId, nameNormalized])
  @@map("setups")
}

model Trade {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  accountId         String          @map("account_id") @db.Uuid
  setupId           String?         @map("setup_id") @db.Uuid
  setupNameSnapshot String?         @map("setup_name_snapshot")
  tradeDate         DateTime        @map("trade_date") @db.Date
  pair              String
  direction         TradeDirection
  entry             Decimal         @db.Decimal(18, 8)
  stopLoss          Decimal         @map("stop_loss") @db.Decimal(18, 8)
  takeProfit        Decimal         @map("take_profit") @db.Decimal(18, 8)
  profit            Decimal         @db.Decimal(18, 2)
  result            TradeResult
  session           TradeSession?
  emotion           TradeEmotion?
  notes             String          @default("")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  setup             Setup?          @relation(fields: [setupId], references: [id], onDelete: SetNull)
  screenshotUploads TradeScreenshotUpload[]
  screenshots       TradeScreenshot[]
  shares            TradeShare[]
  review            Review?
  checklistResponses TradeChecklistResponse[]

  @@index([userId, tradeDate(sort: Desc)])
  @@index([accountId, tradeDate(sort: Desc)])
  @@index([userId, session])
  @@index([userId, emotion])
  @@index([userId, result])
  @@map("trades")
}

model TradeScreenshotUpload {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tradeId     String    @map("trade_id") @db.Uuid
  storageKey  String    @unique @map("storage_key")
  fileName    String    @map("file_name")
  contentType String    @map("content_type")
  fileSize    Int       @map("file_size")
  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade       Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([userId, tradeId])
  @@index([tradeId, createdAt])
  @@index([expiresAt])
  @@map("trade_screenshot_uploads")
}

model TradeScreenshot {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tradeId    String   @map("trade_id") @db.Uuid
  storageKey String   @map("storage_key")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade      Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tradeId])
  @@index([userId, tradeId])
  @@index([tradeId, sortOrder])
  @@map("trade_screenshots")
}

model ScreenshotCleanupTask {
  id              String                  @id @default(uuid()) @db.Uuid
  dedupeKey       String                  @unique @map("dedupe_key")
  action          ScreenshotCleanupAction
  reason          ScreenshotCleanupReason
  storageKey      String?                 @map("storage_key")
  screenshotId    String?                 @map("screenshot_id") @db.Uuid
  uploadId        String?                 @map("upload_id") @db.Uuid
  userId          String?                 @map("user_id") @db.Uuid
  tradeId         String?                 @map("trade_id") @db.Uuid
  attemptCount    Int                     @default(0) @map("attempt_count")
  nextAttemptAt   DateTime                @default(now()) @map("next_attempt_at")
  leaseExpiresAt  DateTime?               @map("lease_expires_at")
  lastError       String?                 @map("last_error")
  lastAttemptAt   DateTime?               @map("last_attempt_at")
  completedAt     DateTime?               @map("completed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([completedAt, nextAttemptAt])
  @@index([action, completedAt, nextAttemptAt])
  @@index([storageKey])
  @@map("screenshot_cleanup_tasks")
}

model TradeShare {
  id            String   @id @default(uuid()) @db.Uuid
  tradeId       String   @map("trade_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  shareId       String   @unique @map("share_id")
  isActive      Boolean  @default(true) @map("is_active")
  viewCount     Int      @default(0) @map("view_count")
  expiresAt     DateTime? @map("expires_at")
  shareSettings Json     @map("share_settings")
  snapshot      Json     @map("snapshot")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  trade         Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tradeId, userId])
  @@index([userId, tradeId])
  @@index([shareId, isActive])
  @@map("trade_shares")
}

model Review {
  id                      String            @id @default(uuid()) @db.Uuid
  userId                  String            @map("user_id") @db.Uuid
  type                    ReviewType
  tradeId                 String?           @unique @map("trade_id") @db.Uuid
  tradeSnapshot           Json?             @map("trade_snapshot")
  reviewDate              DateTime?         @map("review_date") @db.Date
  dailyScopeDate          DateTime?         @map("daily_scope_date") @db.Date
  weekStart               DateTime?         @map("week_start") @db.Date
  weekEnd                 DateTime?         @map("week_end") @db.Date
  weeklyScopeStart        DateTime?         @map("weekly_scope_start") @db.Date
  wentWell                String?           @map("went_well")
  mistakes                String?
  followedRules           ReviewRuleStatus? @map("followed_rules")
  emotion                 ReviewEmotion?
  lessonLearned           String?           @map("lesson_learned")
  improvementPlan         String?           @map("improvement_plan")
  disciplineScore         Int?              @map("discipline_score")
  weeklySummary           String?           @map("weekly_summary")
  biggestWin              String?           @map("biggest_win")
  biggestMistake          String?           @map("biggest_mistake")
  riskManagement          ReviewRiskStatus? @map("risk_management")
  nextGoal                String?           @map("next_goal")
  weeklyRating            Int?              @map("weekly_rating")
  executionRating         Int?              @map("execution_rating")
  emotionRating           Int?              @map("emotion_rating")
  whatWentWell            String?           @map("what_went_well")
  whatWentWrong           String?           @map("what_went_wrong")
  mistakesMade            String?           @map("mistakes_made")
  improvementForNextTrade String?           @map("improvement_for_next_trade")
  wouldTakeAgain          Boolean?          @map("would_take_again")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade                   Trade?            @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  @@unique([userId, dailyScopeDate])
  @@unique([userId, weeklyScopeStart])
  @@index([userId, type, updatedAt(sort: Desc)])
  @@map("reviews")
}

model ChecklistRule {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  description String?
  isRequired  Boolean  @default(false) @map("is_required")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  setupId     String?  @map("setup_id") @db.Uuid
  accountId   String?  @map("account_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setup       Setup?   @relation(fields: [setupId], references: [id], onDelete: SetNull)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  tradeChecklistResponses TradeChecklistResponse[]

  @@index([userId, isActive, sortOrder])
  @@index([userId, setupId, accountId, isActive])
  @@map("checklist_rules")
}

model TradeChecklistResponse {
  id                      String        @id @default(uuid()) @db.Uuid
  tradeId                 String        @map("trade_id") @db.Uuid
  checklistRuleId         String?       @map("checklist_rule_id") @db.Uuid
  ruleTitleSnapshot       String        @map("rule_title_snapshot")
  ruleDescriptionSnapshot String?       @map("rule_description_snapshot")
  isRequiredSnapshot      Boolean       @default(false) @map("is_required_snapshot")
  checked                 Boolean       @default(false)
  note                    String?
  sortOrderSnapshot       Int           @default(0) @map("sort_order_snapshot")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  trade                   Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  checklistRule           ChecklistRule? @relation(fields: [checklistRuleId], references: [id], onDelete: SetNull)

  @@index([tradeId, sortOrderSnapshot])
  @@index([checklistRuleId])
  @@map("trade_checklist_responses")
}
