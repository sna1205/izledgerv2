{
  "name": "@izledger/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace @izledger/shared",
    "build": "tsc -p tsconfig.json",
    "prisma:validate": "node ./scripts/run-prisma-command.mjs validate",
    "prisma:check:migrations": "node ./scripts/check-prisma-migrations.mjs",
    "prisma:check:release": "node ./scripts/check-prisma-release.mjs",
    "release:check": "node ./scripts/check-release-readiness.mjs",
    "release:migrate": "node ./scripts/run-release-migrations.mjs",
    "backup:check": "node ./scripts/check-backup-readiness.mjs",
    "backup:logical": "node ./scripts/run-logical-backup.mjs",
    "restore:verify": "node --import tsx ./scripts/verify-restore.mjs",
    "data:audit": "node --import tsx ./scripts/audit-data-integrity.mjs",
    "data:plan": "node --import tsx ./scripts/plan-data-remediation.mjs",
    "uniqueness:audit": "node ./scripts/audit-uniqueness-candidates.mjs",
    "uniqueness:backfill": "node ./scripts/backfill-scope-uniqueness.mjs",
    "numeric:audit": "node --import tsx ./scripts/audit-numeric-integrity.mjs",
    "numeric:backfill": "node --import tsx ./scripts/backfill-numeric-integrity.mjs",
    "numeric:validate": "node --import tsx ./scripts/validate-numeric-constraints.mjs",
    "screenshots:cleanup:expired": "node --import tsx src/scripts/run-screenshot-cleanup.ts",
    "screenshots:cleanup:run": "node --import tsx src/scripts/run-screenshot-cleanup.ts",
    "screenshots:reconcile": "node --import tsx src/scripts/reconcile-screenshot-storage.ts",
    "start": "node dist/server.js",
    "start:server": "npm run start",
    "test:db:prepare": "node ./scripts/prepare-integration-db.mjs",
    "test:persistence:run": "node --import tsx --import ./test/setup.ts --test ./test/account-default.integration.test.ts ./test/account-deletion.integration.test.ts ./test/trade-persistence.integration.test.ts ./test/checklist.integration.test.ts ./test/review-persistence.integration.test.ts ./test/review-list-pagination.integration.test.ts ./test/ownership-integrity.integration.test.ts ./test/screenshot-validation.integration.test.ts ./test/screenshot-cleanup.integration.test.ts ./test/trade-share.integration.test.ts ./test/trade-share-storage.test.ts",
    "test:persistence": "npm run test:db:prepare && npm run test:persistence:run",
    "check:persistence:release": "node ./scripts/check-persistence-release.mjs",
    "test:run": "node --import tsx --import ./test/setup.ts --test ./test/dashboard-summary.integration.test.ts ./test/account-deletion.integration.test.ts ./test/account-default.integration.test.ts ./test/checklist.integration.test.ts ./test/cors.integration.test.ts ./test/economic-calendar.test.ts ./test/health.integration.test.ts ./test/screenshot-security.test.ts ./test/screenshot-completion-security.test.ts ./test/screenshot-cleanup.integration.test.ts ./test/review-snapshot.test.ts ./test/review-deleted-trade.integration.test.ts ./test/review-date-schema.test.ts ./test/review-date.integration.test.ts ./test/review-list-pagination.integration.test.ts ./test/scope-uniqueness.integration.test.ts ./test/trade-date-schema.test.ts ./test/numeric-validation.test.ts ./test/numeric-validation.integration.test.ts ./test/numeric-constraints.integration.test.ts ./test/error-mapper.test.ts ./test/error-response.integration.test.ts ./test/ownership-integrity.integration.test.ts ./test/screenshot-reorder.test.ts ./test/storage-endpoint.test.ts ./test/username-uniqueness.integration.test.ts ./test/trade-date.integration.test.ts ./test/screenshot-validation.integration.test.ts ./test/trade-share-storage.test.ts ./test/trade-share.integration.test.ts ./test/auth-session.integration.test.ts",
    "test": "npm run test:db:prepare && npm run test:run",
    "prisma:generate": "node ./scripts/run-prisma-command.mjs generate",
    "prisma:migrate:dev": "node ./scripts/run-prisma-command.mjs migrate dev",
    "prisma:migrate:deploy": "npm run release:migrate",
    "prisma:studio": "node ./scripts/run-prisma-command.mjs studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
