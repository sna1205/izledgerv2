{
  "name": "@izledger/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "npm run start:render",
    "start:server": "node dist/server.js",
    "start:render": "node ./scripts/validate-render-db-config.mjs && DATABASE_URL=\"${DIRECT_URL:-$DATABASE_URL}\" prisma migrate deploy && npm run start:server",
    "test": "node --import tsx --test ./test/dashboard-summary.integration.test.ts ./test/account-deletion.integration.test.ts ./test/account-default.integration.test.ts ./test/screenshot-security.test.ts ./test/screenshot-completion-security.test.ts ./test/review-snapshot.test.ts ./test/review-deleted-trade.integration.test.ts ./test/trade-date-schema.test.ts ./test/numeric-validation.test.ts ./test/numeric-validation.integration.test.ts ./test/error-mapper.test.ts ./test/error-response.integration.test.ts ./test/screenshot-reorder.test.ts ./test/username-uniqueness.integration.test.ts ./test/trade-date.integration.test.ts ./test/screenshot-validation.integration.test.ts ./test/trade-share.integration.test.ts ./test/founder-access.integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
