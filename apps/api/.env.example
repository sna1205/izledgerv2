NODE_ENV=development
PORT=4000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/izledger
DIRECT_URL=
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/izledger_test
# Release/CI only: disposable PostgreSQL database used for `prisma migrate diff`.
PRISMA_MIGRATE_CHECK_SHADOW_DATABASE_URL=
SESSION_COOKIE_NAME=izledger_session
SESSION_TTL_DAYS=14
# Production for izledger.xyz -> api.izledger.xyz should use `none` with `SESSION_COOKIE_SECURE=true`.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=1
STORAGE_ENABLED=false
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_READS=true
STORAGE_SIGNED_READ_TTL_SECONDS=900
# Restore drill only: optional restored API origin checked by `npm run restore:verify`.
RESTORE_VERIFY_API_URL=
# Restore drill only: positive integer or `all`.
RESTORE_VERIFY_STORAGE_SAMPLE_SIZE=25
RESTORE_VERIFY_REQUIRE_API=false
RESTORE_VERIFY_REQUIRE_STORAGE=false
LOG_LEVEL=info
