# Copy this file to `.env.local` for local development.
# File-backed runtime sources:
# - development: `.env.local`
# - production: `.env.production`
# - test: `.env.test`

# App mode
NODE_ENV=development
APP_ENV=development
APP_DEBUG=false

# Network
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/izledger
DIRECT_URL=
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/izledger_test
PRISMA_MIGRATE_CHECK_SHADOW_DATABASE_URL=

# Session and auth
SESSION_COOKIE_NAME=izledger_session
SESSION_TTL_DAYS=14
# Use `none` only when the frontend and backend are on different sites.
SESSION_COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=1

# Storage
STORAGE_ENABLED=false
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_SIGNED_READS=true
STORAGE_SIGNED_READ_TTL_SECONDS=900

# Economic calendar
# Use `fair-economy` locally unless you need production-grade historical or future ranges.
ECONOMIC_CALENDAR_PROVIDER=fair-economy
ECONOMIC_CALENDAR_PROVIDER_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
ECONOMIC_CALENDAR_TRADING_ECONOMICS_BASE_URL=https://api.tradingeconomics.com
ECONOMIC_CALENDAR_TRADING_ECONOMICS_API_KEY=
ECONOMIC_CALENDAR_PROVIDER_TIMEOUT_MS=7000
ECONOMIC_CALENDAR_CACHE_TTL_SECONDS=300

# Restore and audit tooling
RESTORE_VERIFY_API_URL=
# Positive integer or `all`.
RESTORE_VERIFY_STORAGE_SAMPLE_SIZE=25
RESTORE_VERIFY_REQUIRE_API=false
RESTORE_VERIFY_REQUIRE_STORAGE=false
RESTORE_VERIFY_REQUIRE_BUCKET_VERSIONING=false

# Backup automation and release attestations
BACKUP_DATABASE_URL=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_OBJECT_PREFIX=postgres/daily
BACKUP_PGDUMP_PATH=pg_dump
BACKUP_PGRESTORE_PATH=pg_restore
BACKUP_LAST_RESTORE_VERIFIED_AT=
RELEASE_CHECK_REQUIRE_BACKUP=false

# Logging
LOG_LEVEL=info
