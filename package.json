{
  "name": "izledger-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash -lc \"/usr/bin/node ./scripts/dev.mjs\"",
    "dev:web": "bash -lc \"/usr/bin/node ./scripts/dev-web.mjs\"",
    "dev:api": "bash -lc \"/usr/bin/node ./scripts/dev-api.mjs\"",
    "start": "npm run build:api && npm run build:web:local && bash -lc \"/usr/bin/node ./scripts/start.mjs\"",
    "start:web": "npm run build:web:local && bash -lc \"/usr/bin/node ./scripts/start-web.mjs\"",
    "start:api": "npm run build:api && bash -lc \"/usr/bin/node ./scripts/start-api.mjs\"",
    "build": "npm run build:api && npm run build:web",
    "build:web": "npm run build --workspace @izledger/web",
    "build:web:local": "npm run build:local --workspace @izledger/web",
    "build:api": "npm run build --workspace @izledger/api",
    "test": "npm run test --workspace @izledger/web",
    "lint": "npm run lint --workspace @izledger/web",
    "prisma:validate": "npm run prisma:validate --workspace @izledger/api",
    "prisma:check:migrations": "npm run prisma:check:migrations --workspace @izledger/api",
    "prisma:check:release": "npm run prisma:check:release --workspace @izledger/api",
    "release:check": "npm run release:check --workspace @izledger/api",
    "backup:check": "npm run backup:check --workspace @izledger/api",
    "backup:logical": "npm run backup:logical --workspace @izledger/api",
    "data:audit": "npm run data:audit --workspace @izledger/api",
    "data:plan": "npm run data:plan --workspace @izledger/api",
    "prisma:generate": "bash -lc \"cd apps/api && /usr/bin/node ../../node_modules/prisma/build/index.js generate\"",
    "prisma:migrate:dev": "bash -lc \"cd apps/api && /usr/bin/node ../../node_modules/prisma/build/index.js migrate dev\"",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @izledger/api",
    "prisma:studio": "bash -lc \"cd apps/api && /usr/bin/node ../../node_modules/prisma/build/index.js studio\"",
    "restore:verify": "npm run restore:verify --workspace @izledger/api",
    "test:persistence": "npm run test:persistence --workspace @izledger/api",
    "check:persistence:release": "npm run check:persistence:release --workspace @izledger/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
