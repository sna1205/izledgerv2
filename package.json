{
  "name": "izledger-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @izledger/web",
    "dev:api": "npm run dev --workspace @izledger/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @izledger/web",
    "build:api": "npm run build --workspace @izledger/api",
    "test": "npm run test --workspace @izledger/web",
    "lint": "npm run lint --workspace @izledger/web",
    "prisma:generate": "npm run prisma:generate --workspace @izledger/api",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace @izledger/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @izledger/api",
    "prisma:studio": "npm run prisma:studio --workspace @izledger/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
